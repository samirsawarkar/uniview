{
  "name": "uniview",
  "productName": "UniView",
  "version": "1.0.0",
  "description": "Open any file. Offline, simple, fast.",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Samir",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "bench": "node scripts/bench.mjs",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json",
    "cap:sync": "npm run build && cap sync android",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/ios": "8.5.3",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "jsqr": "1.4.0",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "utif2": "4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
