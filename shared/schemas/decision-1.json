{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniview.app/schemas/decision-1.json",
  "title": "UniView Review Decision v1",
  "type": "object",
  "required": [
    "uniview",
    "reviewId",
    "receiptDigest",
    "decision",
    "comment",
    "decidedAt",
    "verifiedAt",
    "persisted",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "uniview": {
      "const": "decision/1"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": ["approved", "changes_requested", "dismissed"]
    },
    "comment": {
      "type": "string",
      "maxLength": 8192
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "persisted": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "path",
          "expectedSha256",
          "observedSha256",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observedSha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "unchanged",
              "changed",
              "replaced",
              "missing",
              "unreadable",
              "too_large"
            ]
          }
        }
      }
    }
  }
}
