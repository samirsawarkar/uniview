{
  "appId": "com.uniview.viewer",
  "productName": "UniView",
  "copyright": "Copyright © 2026 Samir",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "shared/**/*",
    "package.json",
    "!**/*.map"
  ],
  "extraResources": [
    {
      "from": "build/uniview-mcp.cmd",
      "to": "uniview-mcp.cmd"
    }
  ],
  "asar": true,
  "npmRebuild": false,
  "electronLanguages": [
    "en-US"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "UniView-Setup-${version}.${ext}",
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "UniView-Portable-${version}.${ext}"
  },
  "mac": {
    "icon": "build/icon.png",
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "hardenedRuntime": true
  },
  "linux": {
    "icon": "build/icon.png",
    "target": [
      "AppImage"
    ],
    "category": "Office"
  }
}
