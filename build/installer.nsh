; Register each format separately so Explorer shows its actual file type.
!macro customInstall
  WriteRegStr SHELL_CONTEXT "Software\RegisteredApplications" "UniView" "Software\UniView\Capabilities"
  WriteRegStr SHELL_CONTEXT "Software\UniView\Capabilities" "ApplicationName" "UniView"
  WriteRegStr SHELL_CONTEXT "Software\UniView\Capabilities" "ApplicationDescription" "View documents and other files with UniView."
  ; Preserve old defaults that still refer to this class until the user chooses again.
  WriteRegStr SHELL_CONTEXT "Software\Classes\UniView.Document" "" "UniView document"
  WriteRegStr SHELL_CONTEXT "Software\Classes\UniView.Document\shell\open\command" "" '"$appExe" "%1"'
