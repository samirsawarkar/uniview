  WriteRegStr SHELL_CONTEXT "Software\UniView\Capabilities\FileAssociations" ".pdf" "UniView.pdf"
  WriteRegNone SHELL_CONTEXT "Software\Classes\.pdf\OpenWithProgids" "UniView.pdf"
